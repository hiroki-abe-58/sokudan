# env / secrets
.env
.env.local
*.key

# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
uv.lock.bak

# data / runs / artifacts (regenerated by scripts)
data/*.jsonl
# Subdirectories too. `data/*.jsonl` matches only the top level, and the ablation
# datasets under data/abl_*/ were committed before this line existed (226 MB, in
# 71a9eac, on the private branch only -- never pushed).
data/**/*.jsonl
# ...except bench_ja: generated at temperature 0.9, so it is NOT reproducible from
# the seed alone. docs/baseline_ja.md reports numbers measured on exactly these items,
# so the items themselves have to be in the repo for anyone to check the claim.
!data/bench_ja.jsonl
# Same reasoning for bench_en: docs/baseline_en.md reports numbers measured on exactly
# these 290 items, and the position-bias finding is the point of the whole file.
!data/bench_en.jsonl
data/cache/
runs/
*.pt
*.safetensors
*.onnx
hf_cache/

# os
Thumbs.db
.DS_Store
