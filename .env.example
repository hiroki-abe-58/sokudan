# ---------------------------------------------------------------------------
# sokudan — environment variables.
# Copy to .env (git-ignored) and fill in. NEVER commit .env or hardcode keys.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Local LLM (bench_ja label-conditioned generation + LLM-as-classifier) ---
# Any OpenAI-compatible endpoint: vLLM, Ollama (/v1), LM Studio, llama.cpp server.
# Ollama default:    http://localhost:11434/v1
# vLLM default:      http://localhost:8000/v1
# LM Studio default: http://localhost:1234/v1
SOKUDAN_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
SOKUDAN_LOCAL_LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# Most local servers ignore the key but OpenAI-compatible clients require a value.
SOKUDAN_LOCAL_LLM_API_KEY=local

# --- Hugging Face (backbone + baseline model download, final model push) ----
HF_TOKEN=
HF_HOME=
# Windows without Developer Mode cannot create the symlinks the HF cache uses; without
# this, snapshot_download fails with WinError 1314 on some drives. Harmless elsewhere.
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
